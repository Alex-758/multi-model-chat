{
  "name": "multi-model-chat",
  "productName": "Multi-Model Chat",
  "version": "1.3.0",
  "description": "同时调用多个大模型并展示、合并回答的本地聊天应用",
  "main": "src/main/main.js",
  "author": "MMC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/gen-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.local.multimodelchat",
    "productName": "Multi-Model Chat",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Multi-Model Chat"
    },
    "portable": {
      "artifactName": "Multi-Model-Chat-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
